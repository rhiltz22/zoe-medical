{
  // Cloudflare Worker that emails website form submissions to
  // customersupport@zoemedical.com via the Email Sending binding.
  "name": "zoe-form-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",

  // Email Sending binding. No API keys needed — the binding sends on
  // behalf of an onboarded domain. The "from" domain in src/index.js
  // (zoemedical.com) must be onboarded first:
  //   npx wrangler email sending enable zoemedical.com
  //
  // The optional "allowed_destination_addresses" restricts who this
  // binding may email — we only send to customer support (sales/general)
  // and service (repair requests), so locking it down is good defense.
  // Each address must be a verified destination in Cloudflare Email
  // Routing. Remove this line if you hit E_RECIPIENT_NOT_ALLOWED during
  // setup and re-add once both addresses are confirmed.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": [
        "customersupport@zoemedical.com",
        "service@zoemedical.com"
      ]
    }
  ],

  "observability": { "enabled": true }
}
